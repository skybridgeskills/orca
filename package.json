{
	"name": "orca",
	"version": "0.0.1",
	"packageManager": "pnpm@10.29.2",
	"scripts": {
		"dev": "vite dev --host 0.0.0.0",
		"debug-dev": "vavite-loader vite dev --m debug-dev --host 0.0.0.0",
		"build": "pnpm generate && vite build",
		"preview": "vite preview",
		"storybook": "storybook dev -p 6006",
		"build:storybook": "storybook build",
		"check": "svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-check --tsconfig ./tsconfig.json --watch",
		"psql": "pnpm exec dotenv -e .env -- psql",
		"test": "pnpm test:unit && pnpm test:e2e",
		"test:e2e": "dotenv -e .env.test -- pnpm exec playwright test",
		"test:unit": "vitest --run --project unit",
		"test:storybook": "vite optimize --force && vitest run --project storybook --reporter=verbose --no-file-parallelism --no-coverage",
		"lint": "prettier --check . && eslint . && pnpm lint:i18n",
		"lint:i18n": "inlang lint --project ./project.inlang",
		"format": "prettier --write .",
		"migrate:dev": "prisma migrate dev --schema src/prisma/schema.prisma",
		"generate": "prisma generate --schema src/prisma/schema.prisma",
		"createAdmin": "pnpm exec tsx src/scripts/createAdmin.ts",
		"createOrganization": "pnpm exec tsx src/scripts/createOrganization.ts",
		"createKeypair": "node src/scripts/createKeypair",
		"createS3BucketLocalStack": "pnpm exec tsx src/scripts/createS3BucketLocalStack.ts"
	},
	"devDependencies": {
		"@digitalbazaar/ed25519-signature-2020": "^5.1.0",
		"@digitalbazaar/ed25519-verification-key-2020": "^4.1.0",
		"@digitalbazaar/vc": "^6.0.0",
		"@eslint/compat": "^1.4.0",
		"@eslint/js": "^9.39.1",
		"@inlang/paraglide-js": "2.11.0",
		"@playwright/test": "^1.40.0",
		"@popperjs/core": "^2.11.8",
		"@storybook/addon-a11y": "10.0.2",
		"@storybook/addon-docs": "10.0.2",
		"@storybook/addon-svelte-csf": "^5.1.2",
		"@storybook/addon-vitest": "10.0.2",
		"@storybook/sveltekit": "10.0.2",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/adapter-node": "^5.5.4",
		"@sveltejs/adapter-vercel": "^6.3.3",
		"@sveltejs/kit": "^2.61.1",
		"@sveltejs/package": "^2.5.7",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@tailwindcss/vite": "^4.3.0",
		"@types/cookie": "^0.5.1",
		"@types/http-link-header": "^1.0.5",
		"@types/inquirer": "^9.0.3",
		"@types/mime-types": "^2.1.1",
		"@types/node": "^24",
		"@types/nodemailer": "^6.4.7",
		"@types/nodemailer-mailgun-transport": "^1.4.3",
		"@types/polka": "^0.5.4",
		"@types/qrcode": "^1.5.5",
		"@types/sanitize-html": "^2.8.0",
		"@types/uuid": "^9.0.0",
		"@types/ws": "^8.5.10",
		"@vavite/node-loader": "^4.1.0",
		"@vitest/browser-playwright": "^4.1.7",
		"aws-cdk": "^2.67.0",
		"concurrently": "^8.2.2",
		"cookie": "^0.6.0",
		"dotenv": "^16.0.3",
		"dotenv-cli": "^7.1.0",
		"eslint": "^9.39.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^16.5.0",
		"helmet": "^7.1.0",
		"http-link-header": "^1.1.3",
		"inquirer": "^9.1.4",
		"jsonwebtoken": "^9.0.0",
		"nodemailer": "^6.9.1",
		"nodemon": "^3.0.1",
		"playwright": "^1.58.2",
		"polka": "^0.5.2",
		"postcss-load-config": "^4.0.1",
		"prettier": "^3.7.4",
		"prettier-plugin-prisma": "^5.0.0",
		"prettier-plugin-svelte": "^4.0.1",
		"prisma": "^5.7.1",
		"sanitize-html": "^2.9.0",
		"storybook": "10.0.2",
		"svelte": "^5.56.0",
		"svelte-check": "^4.4.8",
		"svelte-droplet": "^1.1.0",
		"svelte-eslint-parser": "^1.7.0",
		"svelte-icons-pack": "^3.1.3",
		"svelte-meta-tags": "^4.7.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.60.0",
		"uuid": "^9.0.0",
		"vite": "^7.3.3",
		"vitest": "^4.1.7",
		"vitest-browser-svelte": "^2.1.1",
		"vitest-mock-extended": "^4.0.0",
		"yup": "^1.0.0"
	},
	"type": "module",
	"dependencies": {
		"@aws-sdk/client-s3": "^3.299.0",
		"@aws-sdk/s3-request-presigner": "^3.326.0",
		"@inlang/cli": "^2.0.0",
		"@neondatabase/serverless": "^0.6.1",
		"@prisma/adapter-neon": "^5.7.1",
		"@prisma/client": "^5.7.1",
		"@vitejs/plugin-basic-ssl": "^2.3.0",
		"carta-md": "^4.11.2",
		"credential-handler-polyfill": "^3.2.0",
		"dayjs": "^1.11.9",
		"jsonld-signatures": "^11.2.0",
		"marked": "^9.1.6",
		"mime-types": "^2.1.35",
		"nodemailer-mailgun-transport": "^2.1.5",
		"qrcode": "^1.5.3",
		"ws": "^8.16.0"
	},
	"prisma": {
		"schema": "src/prisma/schema.prisma"
	}
}
